                }
              },
              "buyer_next_step": {
                "type": "string"
              }
            }
          },
          "verification": {
            "type": "object",
            "properties": {
              "count_only": {
                "type": "string"
              },
              "do_not_count": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "source": {
            "type": "string",
            "format": "uri"
          }
        },
        "additionalProperties": true
      },
      "ProductManifest": {
        "type": "object",
        "required": [
          "name",
          "slug",
          "initial_package",
          "fulfillment",
          "counting_rule"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "initial_package": {
            "type": "object",
            "properties": {
              "price_usd": {
                "type": "number",
                "const": 9.9
              },
              "price_cents": {
                "type": "integer",
                "const": 990
              },
              "canonical_marketplace": {
                "type": "string"
              },
              "canonical_service_id": {
                "type": "string"
              },
              "direct_payment": {
                "type": "object"
              }
            },
            "additionalProperties": true
          },
          "fulfillment": {
            "type": "object"
          },
          "counting_rule": {
            "type": "string"
          }
        },
        "additionalProperties": true
      },
      "PaymentRequest": {
        "type": "object",
