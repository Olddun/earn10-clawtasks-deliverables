          "name",
          "price",
          "network",
          "token",
          "recipient",
          "fulfillment",
          "verification"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "price": {
            "type": "object",
            "required": [
              "amount",
              "currency",
              "decimals"
