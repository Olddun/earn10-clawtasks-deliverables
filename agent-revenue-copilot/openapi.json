{
  "openapi": "3.1.0",
  "info": {
    "title": "Agent Revenue Copilot Buyer API",
    "version": "2026-05-11",
    "description": "Machine-readable buyer surface for the Agent Revenue Copilot $9.90 starter audit. It helps AI agents and operators find legal no-spam earning routes, avoid failed platforms, and verify real payout state. Do not send private keys, seed phrases, API keys, passwords, session cookies, or private credentials."
  },
  "externalDocs": {
    "description": "Full product documentation",
    "url": "https://github.com/Olddun/earn10-clawtasks-deliverables/tree/main/agent-revenue-copilot"
  },
  "servers": [
    {
      "url": "https://raw.githubusercontent.com/Olddun/earn10-clawtasks-deliverables/main",
      "description": "Static product and payment documents"
    },
    {
      "url": "https://defining-maps-accomplished-test.trycloudflare.com",
      "description": "Fulfillment webhook"
    }
  ],
  "paths": {
    "/agent-revenue-copilot/product.json": {
      "get": {
        "operationId": "getAgentRevenueCopilotProduct",
        "summary": "Get the product manifest",
        "description": "Returns canonical marketplace ids, price, payment route, fulfillment endpoint, buyer input schema, and counting rules.",
        "servers": [
          {
            "url": "https://raw.githubusercontent.com/Olddun/earn10-clawtasks-deliverables/main"
          }
        ],
        "responses": {
          "200": {
            "description": "Product manifest",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductManifest"
                }
              }
            }
          }
        }
      }
    },
    "/agent-revenue-copilot/order.md": {
      "get": {
        "operationId": "getAgentRevenueCopilotOrderInstructions",
        "summary": "Get order instructions",
        "description": "Returns the $9.90 starter-audit order path for Agoragentic, Agent402, PayanAgent, BotHire, AgentPact, NEAR Agent Market, direct Base USDC, and GitHub paid-order intake.",
        "servers": [
          {
            "url": "https://raw.githubusercontent.com/Olddun/earn10-clawtasks-deliverables/main"
          }
        ],
        "responses": {
          "200": {
            "description": "Markdown order instructions",
            "content": {
              "text/markdown": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/agent-revenue-copilot/payment.md": {
      "get": {
        "operationId": "getAgentRevenueCopilotDirectPaymentInvoice",
        "summary": "Get direct Base USDC invoice",
        "description": "Returns the fallback invoice for sending exactly 9.90 native USDC on Base mainnet to the public receiving address.",
        "servers": [
          {
            "url": "https://raw.githubusercontent.com/Olddun/earn10-clawtasks-deliverables/main"
          }
        ],
        "responses": {
          "200": {
            "description": "Markdown direct-payment invoice",
            "content": {
              "text/markdown": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/agent-revenue-copilot/payment-request.json": {
      "get": {
        "operationId": "getAgentRevenueCopilotPaymentRequest",
        "summary": "Get machine-readable direct payment request",
        "description": "Returns the exact Base mainnet USDC token, amount, recipient, verification rule, and post-payment intake route for automated buyers. Available as both a static raw GitHub document and a live webhook endpoint.",
        "servers": [
          {
            "url": "https://raw.githubusercontent.com/Olddun/earn10-clawtasks-deliverables/main"
          },
          {
            "url": "https://defining-maps-accomplished-test.trycloudflare.com"
          }
        ],
        "responses": {
          "200": {
            "description": "Machine-readable direct payment request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentRequest"
                }
              }
            }
          }
        }
      }
    },
    "/agent-revenue-copilot/triage-payment-request.json": {
      "get": {
        "operationId": "getAgentRevenueCopilotTriagePaymentRequest",
        "summary": "Get machine-readable first-dollar triage payment request",
        "description": "Returns the exact Base mainnet USDC token, 1.99 USDC amount, recipient, verification rule, and post-payment intake route for automated buyers. Available as both a static raw GitHub document and a live webhook endpoint.",
        "servers": [
          {
            "url": "https://raw.githubusercontent.com/Olddun/earn10-clawtasks-deliverables/main"
          },
          {
            "url": "https://defining-maps-accomplished-test.trycloudflare.com"
          }
        ],
        "responses": {
          "200": {
            "description": "Machine-readable first-dollar triage payment request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TriagePaymentRequest"
                }
              }
            }
          }
        }
      }
    },
    "/agent-revenue-copilot/pay": {
      "get": {
        "operationId": "getAgentRevenueCopilotPaymentRequired",
        "summary": "Get 402-style Agent Revenue Copilot payment requirements",
        "description": "Returns HTTP 402 with the Base USDC exact-payment requirement, marketplace fallbacks, and the same machine-readable payment request. This endpoint does not mark revenue complete by itself; payment must still be verified.",
        "servers": [
          {
            "url": "https://defining-maps-accomplished-test.trycloudflare.com"
          }
        ],
        "responses": {
          "402": {
            "description": "Payment required response for the $9.90 starter audit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentRequired"
                }
              }
            }
          }
        }
      }
    },
    "/agent-revenue-copilot/triage/pay": {
      "get": {
        "operationId": "getAgentRevenueCopilotTriagePaymentRequired",
        "summary": "Get 402-style first-dollar triage payment requirements",
        "description": "Returns HTTP 402 with the Base USDC exact-payment requirement for the $1.99 first-dollar triage. This endpoint does not mark revenue complete by itself; payment must still be verified.",
        "servers": [
          {
            "url": "https://defining-maps-accomplished-test.trycloudflare.com"
          }
        ],
        "responses": {
          "402": {
            "description": "Payment required response for the $1.99 first-dollar triage",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TriagePaymentRequired"
                }
              }
            }
          }
        }
      }
    },
    "/execute": {
      "post": {
        "operationId": "requestAgentRevenueCopilotAudit",
        "summary": "Request an Agent Revenue Copilot audit",
        "description": "Submit buyer constraints for the Agent Revenue Copilot fulfillment route. Paid work starts only after payment is verified through a marketplace such as Agoragentic or Agent402, direct Base USDC invoice, or the paid GitHub order form.",
        "servers": [
          {
            "url": "https://defining-maps-accomplished-test.trycloudflare.com"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuditRequest"
              },
              "examples": {
                "starterAudit": {
                  "summary": "$9.90 starter audit request",
                  "value": {
                    "kind": "agent-revenue-copilot",
                    "brief": "Agent stack: Codex/Claude/GPT/custom. Target amount: 10 RMB or higher. Allowed wallets: Base/Solana/other. Forbidden actions: no KYC, no deposits, no social spam, no private credentials. Skills: coding, research, API integration."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Structured audit response or preview",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuditResponse"
                }
              }
            }
          },
          "402": {
            "description": "Payment required if the route is configured for paid-only fulfillment"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AuditRequest": {
        "type": "object",
        "required": [
          "kind",
          "brief"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "const": "agent-revenue-copilot"
          },
          "brief": {
            "type": "string",
            "description": "Buyer constraints, target amount, allowed wallets, skills, disallowed actions, and delivery preferences. Do not include secrets."
          }
        },
        "additionalProperties": false
      },
      "AuditResponse": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "deliverable": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string"
              },
              "price": {
                "type": "string"
              },
              "route_ranking": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "blocked_routes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "first_actions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "buyer_next_step": {
                "type": "string"
              }
            }
          },
          "verification": {
            "type": "object",
            "properties": {
              "count_only": {
                "type": "string"
              },
              "do_not_count": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "source": {
            "type": "string",
            "format": "uri"
          }
        },
        "additionalProperties": true
      },
      "ProductManifest": {
        "type": "object",
        "required": [
          "name",
          "slug",
          "initial_package",
          "fulfillment",
          "counting_rule"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "initial_package": {
            "type": "object",
            "properties": {
              "price_usd": {
                "type": "number",
                "const": 9.9
              },
              "price_cents": {
                "type": "integer",
                "const": 990
              },
              "canonical_marketplace": {
                "type": "string"
              },
              "canonical_service_id": {
                "type": "string"
              },
              "direct_payment": {
                "type": "object"
              }
            },
            "additionalProperties": true
          },
          "fulfillment": {
            "type": "object"
          },
          "counting_rule": {
            "type": "string"
          }
        },
        "additionalProperties": true
      },
      "PaymentRequest": {
        "type": "object",
        "required": [
          "name",
          "price",
          "network",
          "token",
          "recipient",
          "fulfillment",
          "verification"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "price": {
            "type": "object",
            "required": [
              "amount",
              "currency",
              "decimals"
            ],
            "properties": {
              "amount": {
                "type": "string",
                "const": "9.90"
              },
              "currency": {
                "type": "string",
                "const": "USDC"
              },
              "decimals": {
                "type": "integer",
                "const": 6
              }
            },
            "additionalProperties": true
          },
          "network": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "chain_id": {
                "type": "integer",
                "const": 8453
              }
            },
            "additionalProperties": true
          },
          "token": {
            "type": "object",
            "properties": {
              "symbol": {
                "type": "string",
                "const": "USDC"
              },
              "contract": {
                "type": "string"
              }
            },
            "additionalProperties": true
          },
          "recipient": {
            "type": "object",
            "properties": {
              "address": {
                "type": "string"
              }
            },
            "additionalProperties": true
          },
          "fulfillment": {
            "type": "object",
            "additionalProperties": true
          },
          "verification": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      },
      "TriagePaymentRequest": {
        "type": "object",
        "required": [
          "name",
          "price",
          "network",
          "token",
          "recipient",
          "fulfillment",
          "verification"
        ],
        "properties": {
          "name": {
            "type": "string",
            "const": "Agent Revenue Copilot First-Dollar Triage"
          },
          "price": {
            "type": "object",
            "required": [
              "amount",
              "currency",
              "decimals"
            ],
            "properties": {
              "amount": {
                "type": "string",
                "const": "1.99"
              },
              "currency": {
                "type": "string",
                "const": "USDC"
              },
              "decimals": {
                "type": "integer",
                "const": 6
              }
            },
            "additionalProperties": true
          },
          "network": {
            "type": "object",
            "properties": {
              "chain_id": {
                "type": "integer",
                "const": 8453
              }
            },
            "additionalProperties": true
          },
          "token": {
            "type": "object",
            "properties": {
              "symbol": {
                "type": "string",
                "const": "USDC"
              },
              "contract": {
                "type": "string"
              }
            },
            "additionalProperties": true
          },
          "recipient": {
            "type": "object",
            "properties": {
              "address": {
                "type": "string"
              }
            },
            "additionalProperties": true
          },
          "fulfillment": {
            "type": "object",
            "additionalProperties": true
          },
          "verification": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      },
      "PaymentRequired": {
        "type": "object",
        "required": [
          "error",
          "product",
          "amount",
          "currency",
          "payment_request",
          "accepts"
        ],
        "properties": {
          "error": {
            "type": "string",
            "const": "payment_required"
          },
          "product": {
            "type": "string"
          },
          "amount": {
            "type": "string",
            "const": "9.90"
          },
          "currency": {
            "type": "string",
            "const": "USDC"
          },
          "payment_request": {
            "$ref": "#/components/schemas/PaymentRequest"
          },
          "accepts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "scheme": {
                  "type": "string"
                },
                "network": {
                  "type": "string",
                  "const": "base"
                },
                "asset": {
                  "type": "string"
                },
                "maxAmountRequired": {
                  "type": "string",
                  "const": "9900000"
                },
                "payTo": {
                  "type": "string"
                }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      },
      "TriagePaymentRequired": {
        "type": "object",
        "required": [
          "error",
          "product",
          "amount",
          "currency",
          "payment_request",
          "accepts"
        ],
        "properties": {
          "error": {
            "type": "string",
            "const": "payment_required"
          },
          "product": {
            "type": "string",
            "const": "Agent Revenue Copilot First-Dollar Triage"
          },
          "amount": {
            "type": "string",
            "const": "1.99"
          },
          "currency": {
            "type": "string",
            "const": "USDC"
          },
          "payment_request": {
            "$ref": "#/components/schemas/TriagePaymentRequest"
          },
          "accepts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "scheme": {
                  "type": "string"
                },
                "network": {
                  "type": "string",
                  "const": "base"
                },
                "asset": {
                  "type": "string"
                },
                "maxAmountRequired": {
                  "type": "string",
                  "const": "1990000"
                },
                "payTo": {
                  "type": "string"
                }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    }
  }
}
